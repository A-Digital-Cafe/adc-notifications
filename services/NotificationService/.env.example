# Base Mongo aislada para las notificaciones (vista lógica sobre la conexión de la plataforma).
NOTIFICATIONS_DB_NAME=adc-notifications
# Días de retención de notificaciones LEÍDAS (contados desde su creación, no desde
# la lectura). Las no leídas se conservan indefinidamente. 0 = nunca purgar.
NOTIFICATIONS_RETENTION_DAYS=365
# Remitente del canal email (solo se usa si EmailService está cargado).
NOTIFICATIONS_SYSTEM_FROM=no-reply@adigitalcafe.com
