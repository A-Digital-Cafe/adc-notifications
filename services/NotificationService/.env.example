# Base Mongo aislada para las notificaciones (vista lógica sobre la conexión de la plataforma).
NOTIFICATIONS_DB_NAME=adc-notifications
# Días de retención de notificaciones LEÍDAS (contados desde su creación, no desde
# la lectura). Las no leídas se conservan indefinidamente. 0 = nunca purgar.
NOTIFICATIONS_RETENTION_DAYS=365
# Remitente del canal email (solo se usa si EmailService está cargado).
NOTIFICATIONS_SYSTEM_FROM=no-reply@adigitalcafe.com
# URL de las preferencias de notificación, enlazada en el pie de baja de cada email.
NOTIFICATIONS_PREFERENCES_URL=https://my-account.adigitalcafe.com/
# Destino de la cabecera `List-Unsubscribe` (RFC 8058): el endpoint público que aplica la baja.
# Tiene que ser una URL **absoluta** —la cabecera no admite rutas relativas— y apuntar al
# `POST /api/notifications/unsubscribe`. Las rutas `/api/*` se sirven en todos los hosts de la
# plataforma, así que el subdominio de "Mi cuenta" sirve igual que el principal y deja el
# enlace del correo del lado donde la persona termina gestionando sus preferencias.
# Vacío = no se emite la cabecera (el pie de baja del cuerpo del email sigue yendo igual).
NOTIFICATIONS_UNSUBSCRIBE_URL=https://my-account.adigitalcafe.com/api/notifications/unsubscribe
